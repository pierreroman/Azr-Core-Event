{
  "routes": [
    {
      "route": "/watch",
      "rewrite": "/watch.html"
    },
    {
      "route": "/about",
      "rewrite": "/about.html"
    },
    {
      "route": "/schedule",
      "rewrite": "/schedule.html"
    },
    {
      "route": "/speakers",
      "rewrite": "/speakers.html"
    },
    {
      "route": "/sponsors",
      "rewrite": "/sponsors.html"
    },
    {
      "route": "/code-of-conduct",
      "rewrite": "/code-of-conduct.html"
    },
    {
      "route": "/admin.html",
      "allowedRoles": ["administrator"]
    },
    {
      "route": "/schedule-admin.html",
      "allowedRoles": ["administrator"]
    },
    {
      "route": "/speakers-admin.html",
      "allowedRoles": ["administrator"]
    },
    {
      "route": "/sponsors-admin.html",
      "allowedRoles": ["administrator"]
    },
    {
      "route": "/api/schedule",
      "methods": ["POST"],
      "allowedRoles": ["administrator"]
    },
    {
      "route": "/api/schedule/*",
      "methods": ["PUT", "DELETE"],
      "allowedRoles": ["administrator"]
    },
    {
      "route": "/api/schedule",
      "methods": ["GET"],
      "allowedRoles": ["anonymous"]
    },
    {
      "route": "/api/speakers",
      "methods": ["POST"],
      "allowedRoles": ["administrator"]
    },
    {
      "route": "/api/speakers/*",
      "methods": ["PUT", "DELETE", "POST"],
      "allowedRoles": ["administrator"]
    },
    {
      "route": "/api/speakers",
      "methods": ["GET"],
      "allowedRoles": ["anonymous"]
    },
    {
      "route": "/api/speakers/*",
      "methods": ["GET"],
      "allowedRoles": ["anonymous"]
    },
    {
      "route": "/api/sponsors",
      "methods": ["POST"],
      "allowedRoles": ["administrator"]
    },
    {
      "route": "/api/sponsors/*",
      "methods": ["PUT", "DELETE", "POST"],
      "allowedRoles": ["administrator"]
    },
    {
      "route": "/api/sponsors",
      "methods": ["GET"],
      "allowedRoles": ["anonymous"]
    },
    {
      "route": "/api/sponsors/*",
      "methods": ["GET"],
      "allowedRoles": ["anonymous"]
    },
    {
      "route": "/api/content/*",
      "methods": ["PUT", "DELETE"],
      "allowedRoles": ["administrator"]
    },
    {
      "route": "/api/content/*",
      "methods": ["GET"],
      "allowedRoles": ["anonymous"]
    },
    {
      "route": "/api/registration",
      "methods": ["PUT"],
      "allowedRoles": ["administrator"]
    },
    {
      "route": "/api/registration",
      "methods": ["GET"],
      "allowedRoles": ["anonymous"]
    },
    {
      "route": "/api/branding",
      "methods": ["PUT"],
      "allowedRoles": ["administrator"]
    },
    {
      "route": "/api/branding",
      "methods": ["GET"],
      "allowedRoles": ["anonymous"]
    },
    {
      "route": "/api/favorites",
      "methods": ["GET", "POST"],
      "allowedRoles": ["authenticated"]
    },
    {
      "route": "/api/favorites/*",
      "methods": ["GET", "PUT", "DELETE", "POST"],
      "allowedRoles": ["authenticated"]
    },
    {
      "route": "/login",
      "redirect": "/.auth/login/aad",
      "statusCode": 302
    },
    {
      "route": "/logout",
      "redirect": "/.auth/logout",
      "statusCode": 302
    }
  ],
  "responseOverrides": {
    "401": {
      "statusCode": 302,
      "redirect": "/.auth/login/aad?post_login_redirect_uri=/admin.html"
    }
  },
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": ["/api/*", "/*.html", "/styles.css", "/*.json"]
  },
  "globalHeaders": {
    "X-Content-Type-Options": "nosniff",
    "X-Frame-Options": "DENY",
    "Content-Security-Policy": "default-src 'self'; script-src 'self' 'unsafe-inline' https://www.youtube.com https://www.google.com https://www.gstatic.com https://apis.google.com https://cdnjs.cloudflare.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' data:; frame-src https://www.youtube.com; connect-src 'self' https://www.googleapis.com"
  }
}
