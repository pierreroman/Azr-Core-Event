{
  "name": "azr-core-event",
  "version": "1.0.0",
  "description": "A reusable community conference website featuring dynamic schedule management, YouTube video integration, speaker profiles, and sponsor management — all backed by Azure Functions, Table Storage, and Blob Storage with managed identity.",
  "main": "index.js",
  "scripts": {
    "test": "npx playwright test",
    "test:ui": "npx playwright test --ui",
    "test:headed": "npx playwright test --headed",
    "test:chromium": "npx playwright test --project=chromium",
    "test:api": "npx playwright test tests/api.spec.js",
    "test:authorization": "node --test api/test/authorization.test.js",
    "test:migration": "pwsh -NoProfile -File tests/migration-scripts.test.ps1",
    "test:deployment": "pwsh -NoProfile -File tests/deployment-scripts.test.ps1",
    "test:private-deployment": "pwsh -NoProfile -File tests/private-deployment.test.ps1",
    "package:site": "pwsh -NoProfile -File scripts/New-SitePackage.ps1",
    "test:report": "npx playwright show-report"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pierreroman/Azr-Core-Event.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/pierreroman/Azr-Core-Event/issues"
  },
  "homepage": "https://github.com/pierreroman/Azr-Core-Event#readme",
  "devDependencies": {
    "@azure/static-web-apps-cli": "2.1.0",
    "@playwright/test": "^1.58.2"
  }
}
